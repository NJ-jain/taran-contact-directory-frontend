# ==========================================
# Frontend Git Ignore Rules
# ==========================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing & Coverage
/coverage

# Production & Build Artifacts
/build
/dist
.next/
out/

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
# Exception: Always track example configuration
!.env.example

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Caches
.eslintcache
.cache/

# Cloud & Hosting
.vercel/

# OS Specific
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE & Editor Specific
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
